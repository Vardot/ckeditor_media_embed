# The gitlab_templates default (assets/phpstan.neon), plus what this branch
# needs. Every ignore below names its file and how many times it may match,
# so a new error of the same kind still fails the job.
parameters:
  level: 0
  fileExtensions:
    - php
    - module
    - inc
    - install
    - theme
    - profile
  reportUnmatchedIgnoredErrors: false
  excludePaths:
    # The Drupal Console commands. Drupal Console cannot be installed on
    # Drupal 10, so the classes they extend do not exist to analyse them.
    - src/Command/InstallCommand.php
    - src/Command/UpdateCommand.php
  ignoreErrors:
    # new static() is a best practice in Drupal, so we cannot fix that.
    - '#^Unsafe usage of new static#'
    # The Drush command sets $input, $output and $io without declaring them
    # (dynamic properties, deprecated since PHP 8.2): #3547486.
    -
      message: '#^Access to an undefined property Drupal\\ckeditor_media_embed\\Command\\Drush\\InstallCommand::\$(input|output|io)\.$#'
      path: src/Command/Drush/InstallCommand.php
      count: 7
    # Deprecated in drupal:10.1.0. Its replacement, Error::logException(),
    # does not exist before Drupal 10.1, and this branch supports Drupal 8
    # and 9 too.
    -
      message: '#^Call to deprecated function watchdog_exception\(\)#'
      path: src/Embed.php
      count: 1
    # Dependency injection in the legacy plugin and command classes is a
    # refactor of its own, not part of adding tests.
    -
      message: '#^\\Drupal calls should be avoided in classes, use dependency injection instead$#'
      path: src/Command/Drush/InstallCommand.php
      count: 1
    -
      message: '#^\\Drupal calls should be avoided in classes, use dependency injection instead$#'
      path: src/Plugin/CKEditorPlugin/MediaEmbedBase.php
      count: 2
    # A known bug, not fixed in a tests merge request: AssetManager catches
    # and throws two exception classes it does not import, so the catch never
    # matches and an invalid libraries file throws the original exception.
    -
      message: '#^Caught class Drupal\\ckeditor_media_embed\\InvalidDataTypeException not found\.$#'
      path: src/AssetManager.php
      count: 1
    -
      message: '#^Instantiated class Drupal\\ckeditor_media_embed\\InvalidLibraryFileException not found\.$#'
      path: src/AssetManager.php
      count: 1
